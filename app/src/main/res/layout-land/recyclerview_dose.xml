<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_rvDose"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:baselineAligned="false"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp"
    android:orientation="horizontal"
    android:longClickable="true"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/ll_rvDose_doseInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_contour_colored">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_top_tertiary"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_rvDose_expired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:contentDescription="@string/expired"
                app:srcCompat="@drawable/ic_baseline_access_time_24"
                app:tint="?lighterText" />

            <ImageView
                android:id="@+id/iv_rvDose_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/active"
                app:srcCompat="@drawable/ic_baseline_access_time_filled_24"
                app:tint="?greenText" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/tv_rvDose_expires"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:breakStrategy="balanced"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_rvDose_expiresAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:breakStrategy="balanced"
                        android:textColor="?attr/lightText"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_rvDose_notificationWithSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableTint="?attr/lightText"
                    app:drawableStartCompat="@drawable/baseline_notifications_active_24"
                    android:drawablePadding="4dp"
                    android:breakStrategy="balanced"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/lightText"
                    android:textSize="12sp"
                    android:text="@string/notification_with_sound" />

                <TextView
                    android:id="@+id/tv_rvDose_notificationWithoutSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableTint="?attr/lightText"
                    app:drawableStartCompat="@drawable/baseline_notifications_24"
                    android:drawablePadding="4dp"
                    android:breakStrategy="balanced"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/lightText"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:text="@string/notification_without_sound" />

                <TextView
                    android:id="@+id/tv_rvDose_noNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableTint="?attr/lightText"
                    app:drawableStartCompat="@drawable/baseline_notifications_24"
                    android:drawablePadding="4dp"
                    android:breakStrategy="balanced"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/lightText"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:text="@string/no_notification" />

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_rvDose_unselected"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:visibility="gone"
                android:contentDescription="@string/unselected"
                app:srcCompat="@drawable/baseline_radio_button_unchecked_24" />

            <ImageView
                android:id="@+id/iv_rvDose_selected"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:visibility="gone"
                android:contentDescription="@string/selected"
                app:srcCompat="@drawable/baseline_check_circle_24" />

            <ImageButton
                android:id="@+id/btn_rvDose_more"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:backgroundTint="#00FFFFFF"
                app:srcCompat="@drawable/ic_baseline_more_vert_24"
                android:contentDescription="@string/more_options" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_bottom_secondary"
            android:paddingStart="40dp"
            android:paddingEnd="8dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_rvDose_taken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced" />

            <TextView
                android:id="@+id/tv_rvDose_takenAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced"
                android:layout_marginStart="18dp"
                android:textColor="?attr/lightText"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>