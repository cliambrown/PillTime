    <string name="notifications_disabled">Warning: Pill Time notifications are disabled by your device due to missing permissions. Open your device settings to allow Pill Time to send notifications.</string>
    <string name="exact_alarms_denied_title">Delayed Notifications</string>
    <string name="exact_alarms_denied">Your notifications may be delayed by up to 10 minutes because
        the "Exact Alarm" permission was refused. To get notifications at the correct time when
        doses expire, open your device\'s settings and switch on the Alarm permission for Pill Time.
    </string>
