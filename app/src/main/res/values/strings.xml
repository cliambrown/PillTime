    <string name="tips_title">Tips</string>
    <string name="tip_quick_dose_title">Quick Dose</string>
    <string name="tip_quick_dose">On the main screen, long-press the plus button next to a med to quickly add a new dose. (On a Med page, long-press the "Add a dose" button.)</string>
    <string name="tip_edit_med_title">Med Options</string>
    <string name="tip_edit_med">Open a med and tap the pencil icon to edit its standard dose amount, notification defaults, colour, inventory, and more.</string>
    <string name="tip_archive_med_title">Archiving Meds</string>
    <string name="tip_archive_med">Archive a med by clicking the box icon with the down arrow on the med page. This will hide it from the main screen (the med\'s settings and doses will not be affected).
        \nView your archived meds by clicking the box icon on the main screen.</string>
    <string name="tip_no_notifications_title">Missing or Delayed Notifications</string>
    <string name="tip_no_notifications">If you are not getting notifications or they arrive late, Pill Time may be missing certain device permissions. Try the following fixes (the steps may look slightly different on different devices):</string>
    <string name="tip_delayed_notifications_2">Device Settings > Apps > Pill Time > Notifications > enable all</string>
    <string name="tip_delayed_notifications_3">Device Settings > Apps > Pill Time > App battery usage > Allow background usage > On</string>
    <string name="tip_delayed_notifications_4">Device Settings > Apps > Pill Time > App battery usage > Allow background usage (tap for options) > Unrestricted</string>
    <string name="tip_delayed_notifications_5">Device Settings > Apps > Special app access > Alarm &amp; reminders > Pill Time > On</string>

