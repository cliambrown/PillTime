    <string name="permission_required">Permission Required</string>
    <string name="exact_alarm_permission_explanation">This app requires the "exact alarm" permission
        to show notifications as soon as a dose expires. (Exactly timed notifications use a bit more
        battery power.)\n
        \nWithout this permission, notifications may arrive up to 10 minutes after a dose has
        expired.\n
        \nDo you want to continue to the permissions page to receive your dose notifications
        on time, or ignore this and accept slightly delayed notifications?
    </string>
    <string name="continue_option">Go to settings</string>
